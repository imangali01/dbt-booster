{
  "name": "dbt-booster",
  "displayName": "dbt booster",
  "description": "Lineage graph and one-click run / test / build / preview for dbt models.",
  "version": "0.0.33",
  "license": "MIT",
  "icon": "media/dbt-logo.png",
  "publisher": "imangali01",
  "repository": {
    "type": "git",
    "url": "https://github.com/imangali01/dbt-booster.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbtBooster.selectProject",
        "title": "Select dbt Project",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.showActiveProject",
        "title": "Show Active Project",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.showModelCount",
        "title": "Show Model Count",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.refreshLineage",
        "title": "Refresh Lineage",
        "category": "dbt booster",
        "icon": "$(refresh)"
      },
      {
        "command": "dbtBooster.runModel",
        "title": "Run Model",
        "category": "dbt booster",
        "icon": "$(play)"
      },
      {
        "command": "dbtBooster.runModelWithUpstream",
        "title": "Run with Upstream (+model)",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.runModelWithDownstream",
        "title": "Run with Downstream (model+)",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.runModelWithBoth",
        "title": "Run with Upstream and Downstream (+model+)",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.testModel",
        "title": "Test Model",
        "category": "dbt booster",
        "icon": "$(beaker)"
      },
      {
        "command": "dbtBooster.buildModel",
        "title": "Build Model",
        "category": "dbt booster",
        "icon": "$(package)"
      },
      {
        "command": "dbtBooster.buildModelWithUpstream",
        "title": "Build with Upstream (+model)",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.buildModelWithDownstream",
        "title": "Build with Downstream (model+)",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.buildModelWithBoth",
        "title": "Build with Upstream and Downstream (+model+)",
        "category": "dbt booster"
      },
      {
        "command": "dbtBooster.previewData",
        "title": "Preview Data",
        "category": "dbt booster",
        "icon": "$(table)"
      },
      {
        "command": "dbtBooster.previewSelectedSql",
        "title": "Preview Selected SQL",
        "category": "dbt booster",
        "icon": "$(table)"
      },
      {
        "command": "dbtBooster.selectPythonEnvironment",
        "title": "Select Python Environment",
        "category": "dbt booster",
        "icon": "$(server-environment)"
      },
      {
        "command": "dbtBooster.diagnosePerformance",
        "title": "Diagnose dbt Performance",
        "category": "dbt booster",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dbtBooster.selectProject",
          "when": "dbtBooster.multipleProjects"
        },
        {
          "command": "dbtBooster.showActiveProject",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.showModelCount",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.refreshLineage",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.runModel",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.runModelWithUpstream",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.runModelWithDownstream",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.runModelWithBoth",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.testModel",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.buildModel",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.buildModelWithUpstream",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.buildModelWithDownstream",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.buildModelWithBoth",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.previewData",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.previewSelectedSql",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.selectPythonEnvironment",
          "when": "dbtBooster.projectDetected"
        },
        {
          "command": "dbtBooster.diagnosePerformance",
          "when": "dbtBooster.projectDetected"
        }
      ],
      "view/title": [
        {
          "command": "dbtBooster.refreshLineage",
          "when": "view == dbtBooster.lineage",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dbtBooster.previewSelectedSql",
          "when": "editorHasSelection && resourceExtname == .sql && dbtBooster.projectDetected",
          "group": "dbtBooster@1"
        }
      ],
      "editor/title": [
        {
          "command": "dbtBooster.runModel",
          "when": "resourceExtname == .sql && dbtBooster.projectDetected",
          "group": "navigation@1"
        },
        {
          "submenu": "dbtBooster.runVariants",
          "when": "resourceExtname == .sql && dbtBooster.projectDetected",
          "group": "navigation@2"
        },
        {
          "command": "dbtBooster.testModel",
          "when": "resourceExtname == .sql && dbtBooster.projectDetected",
          "group": "navigation@3"
        },
        {
          "command": "dbtBooster.buildModel",
          "when": "resourceExtname == .sql && dbtBooster.projectDetected",
          "group": "navigation@4"
        },
        {
          "submenu": "dbtBooster.buildVariants",
          "when": "resourceExtname == .sql && dbtBooster.projectDetected",
          "group": "navigation@5"
        },
        {
          "command": "dbtBooster.previewData",
          "when": "resourceExtname == .sql && dbtBooster.projectDetected",
          "group": "navigation@6"
        }
      ],
      "dbtBooster.runVariants": [
        {
          "command": "dbtBooster.runModel",
          "group": "1_scope@1"
        },
        {
          "command": "dbtBooster.runModelWithUpstream",
          "group": "1_scope@2"
        },
        {
          "command": "dbtBooster.runModelWithDownstream",
          "group": "1_scope@3"
        },
        {
          "command": "dbtBooster.runModelWithBoth",
          "group": "1_scope@4"
        }
      ],
      "dbtBooster.buildVariants": [
        {
          "command": "dbtBooster.buildModel",
          "group": "1_scope@1"
        },
        {
          "command": "dbtBooster.buildModelWithUpstream",
          "group": "1_scope@2"
        },
        {
          "command": "dbtBooster.buildModelWithDownstream",
          "group": "1_scope@3"
        },
        {
          "command": "dbtBooster.buildModelWithBoth",
          "group": "1_scope@4"
        }
      ]
    },
    "submenus": [
      {
        "id": "dbtBooster.runVariants",
        "label": "Run With…",
        "icon": "$(chevron-down)"
      },
      {
        "id": "dbtBooster.buildVariants",
        "label": "Build With…",
        "icon": "$(chevron-down)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "dbtBoosterPanel",
          "title": "Lineage",
          "icon": "media/dbt-logo.png"
        },
        {
          "id": "dbtBoosterDocsPanel",
          "title": "Docs",
          "icon": "media/dbt-logo.png"
        }
      ],
      "activitybar": [
        {
          "id": "dbtBoosterActivityBar",
          "title": "dbt booster",
          "icon": "media/dbt-logo.png"
        }
      ]
    },
    "views": {
      "dbtBoosterPanel": [
        {
          "id": "dbtBooster.lineage",
          "name": "Lineage",
          "type": "webview"
        }
      ],
      "dbtBoosterDocsPanel": [
        {
          "id": "dbtBooster.docs",
          "name": "Docs",
          "type": "webview"
        }
      ],
      "dbtBoosterActivityBar": [
        {
          "id": "dbtBooster.modelTests",
          "name": "Model Tests"
        },
        {
          "id": "dbtBooster.parentModels",
          "name": "Parent Models"
        },
        {
          "id": "dbtBooster.childrenModels",
          "name": "Children Models"
        },
        {
          "id": "dbtBooster.documentation",
          "name": "Documentation"
        },
        {
          "id": "dbtBooster.projectInfo",
          "name": "Project"
        }
      ]
    },
    "configuration": {
      "title": "dbt booster",
      "properties": {
        "dbtBooster.dbtPath": {
          "type": "string",
          "default": "dbt",
          "description": "Command used to invoke dbt (e.g. \"dbt\", an absolute path, or \"uv run dbt\")."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "@xyflow/react": "^12.3.0",
    "dagre": "^0.8.5",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.0"
  }
}
